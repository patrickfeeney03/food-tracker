{
  "name": "calories",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "node node_modules/playwright/cli.js test --config playwright.pwa.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "tsx src/lib/server/db/seed.ts",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "cf:types": "wrangler types --include-runtime false --strict-vars false worker-configuration.d.ts && node scripts/bindings-types.mjs",
    "cf:dev": "wrangler dev",
    "deploy:staging": "npm run check && npm run build && npm run db:migrate:staging && wrangler deploy --env staging",
    "deploy:production": "npm run check && npm run build && npm run db:migrate:production && wrangler deploy --env production && npm run deploy:backup",
    "db:export:sqlite": "node scripts/export-sqlite.mjs",
    "db:verify": "node scripts/verify-d1.mjs",
    "backup": "node scripts/backup-d1.mjs",
    "deploy:backup": "wrangler deploy --config wrangler.backup.jsonc",
    "backup:verify": "node scripts/verify-backup.mjs",
    "deploy": "npm run deploy:production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@vitest/browser-playwright": "^4.1.8",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.4.1",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "miniflare": "^4.20260730.0",
    "playwright": "^1.60.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "arctic": "^3.7.0",
    "zod": "^4.4.3"
  },
  "volta": {
    "node": "24.18.0"
  }
}
